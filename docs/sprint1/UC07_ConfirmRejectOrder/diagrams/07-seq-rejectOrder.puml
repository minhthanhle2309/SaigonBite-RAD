@startuml
hide footbox
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam ArrowColor #235573
skinparam activityBackgroundColor #EAF4F8
skinparam classBackgroundColor #EAF4F8
skinparam stateBackgroundColor #EAF4F8
skinparam sequenceParticipantBackgroundColor #EAF4F8
skinparam dpi 180
title Object Sequence Diagram Reject Order\nUC07\n<size:12>Lê Đỗ Minh Thành – 524H0030</size>
actor "Kitchen Staff" as A
boundary ":KitchenOrderView" as V
control ":OrderDecisionController" as C
entity "order:Order" as O
database ":OrderRepository" as R
note over A,V : cannot fulfil
A -> V : rejectOrder(id, reason)
V -> C : rejectOrder(id, reason)
C -> R : findForHub(id, currentScope)
alt order found in current scope
R --> C : order
note over C,O : expectedVersion = order.version
C -> O : reject(reason)
alt Order is Pending and reason present
O --> C : valid
C -> R : save(order, expectedVersion)
alt save succeeds
R --> C : saved
C --> V : Rejected
V --> A : show Rejected
else conflict or storage error
R --> C : conflict or storage error
C --> V : error
V --> A : show error and reload guidance
end
else domain validation error
O --> C : invalid
C --> V : error
V --> A : show error
end
else order missing or out of scope
R --> C : none
C --> V : error
V --> A : show error
end
@enduml

