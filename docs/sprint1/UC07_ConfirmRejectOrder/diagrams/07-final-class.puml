@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam ArrowColor #235573
skinparam activityBackgroundColor #EAF4F8
skinparam classBackgroundColor #EAF4F8
skinparam stateBackgroundColor #EAF4F8
skinparam sequenceParticipantBackgroundColor #EAF4F8
skinparam dpi 180
title Final Design Class Diagram\nUC07\n<size:12>Lê Đỗ Minh Thành – 524H0030</size>
!pragma layout smetana
skinparam classAttributeIconSize 0
class KitchenOrderView <<view>> {
+openOrder(id: OrderId): DetailsResult
+confirmOrder(id: OrderId): Outcome
+rejectOrder(id: OrderId, reason: String): Outcome
}
class OrderDecisionController <<controller>> {
-currentScope: AccessScope
+openOrder(id: OrderId): DetailsResult
+confirmOrder(id: OrderId): Outcome
+rejectOrder(id: OrderId, reason: String): Outcome
}
class Order <<domain>> {
-id: OrderId
-status: OrderStatus
-version: Integer
-rejectionReason: String [0..1]
+confirm(): Validation
+reject(reason: String): Validation
}
interface OrderRepository <<data access>> {
+findForHub(id: OrderId, scope: AccessScope): Order [0..1]
+save(order: Order, expectedVersion: Integer): SaveResult
}
KitchenOrderView --> OrderDecisionController
OrderDecisionController --> OrderRepository
OrderDecisionController ..> Order
OrderRepository ..> Order
@enduml

