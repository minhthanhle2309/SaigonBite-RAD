@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam ArrowColor #235573
skinparam activityBackgroundColor #EAF4F8
skinparam classBackgroundColor #EAF4F8
skinparam stateBackgroundColor #EAF4F8
skinparam sequenceParticipantBackgroundColor #EAF4F8
skinparam dpi 180
title Deliver Order System Sequence Diagram 2 of 2\nUC10\n<size:12>Lê Đỗ Minh Thành – 524H0030</size>
actor "Shipper" as A
participant "OFDH System" as S
note over A,S : Order is OutForDelivery
alt handover completed
A -> S : confirmDelivery(id, cash)
alt assigned, OutForDelivery, valid payment input and save succeeds
S --> A : Delivered
else validation or save fails
S --> A : error
end
else cannot deliver
A -> S : reportFailure(id, reason)
alt assigned, OutForDelivery, reason present and save succeeds
S --> A : Failed
else validation or save fails
S --> A : error
end
end
@enduml

