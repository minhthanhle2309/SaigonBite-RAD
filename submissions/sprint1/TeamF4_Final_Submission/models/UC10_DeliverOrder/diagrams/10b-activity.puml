@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam ArrowColor #235573
skinparam activityBackgroundColor #EAF4F8
skinparam classBackgroundColor #EAF4F8
skinparam stateBackgroundColor #EAF4F8
skinparam sequenceParticipantBackgroundColor #EAF4F8
skinparam dpi 180
title Deliver Order Activity Diagram 2 of 2\nUC10\n<size:12>Lê Đỗ Minh Thành – 524H0030</size>
start
:Order is OutForDelivery;
:Attempt handover;
while (Delayed but delivery still possible?) is (Yes)
:Continue delivery (OutForDelivery);
endwhile (No)
if (Can complete delivery?) then (Yes)
if (Payment method?) then (COD)
:Collect cash and enter amount;
else (Online)
:Set cash to null;
endif
:confirmDelivery(id, cash);
if (Assigned, OutForDelivery, payment input valid\nand save succeeds?) then (Yes)
:Return Delivered;
else (No)
:Return validation or save error;
endif
else (No)
:Enter failure reason;
:reportFailure(id, reason);
if (Assigned, OutForDelivery, reason present\nand save succeeds?) then (Yes)
:Return Failed;
else (No)
:Return validation or save error;
endif
endif
stop
@enduml

