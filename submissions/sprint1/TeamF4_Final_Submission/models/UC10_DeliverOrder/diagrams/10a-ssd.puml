@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam ArrowColor #235573
skinparam activityBackgroundColor #EAF4F8
skinparam classBackgroundColor #EAF4F8
skinparam stateBackgroundColor #EAF4F8
skinparam sequenceParticipantBackgroundColor #EAF4F8
skinparam dpi 180
title Deliver Order System Sequence Diagram 1 of 2\nUC10\n<size:12>Lê Đỗ Minh Thành – 524H0030</size>
actor "Shipper" as A
participant "OFDH System" as S
A -> S : openDelivery(id)
alt assigned delivery found
alt Delivered or Failed
S --> A : order ID and outcome only
else active delivery
S --> A : delivery details
A -> S : confirmPickup(id)
alt assigned, Ready and save succeeds
S --> A : OutForDelivery
else invalid pickup or save error
S --> A : error
end
end
else invalid order
S --> A : error
end
@enduml

